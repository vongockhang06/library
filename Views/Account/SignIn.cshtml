@model library.ViewModels.Account.SignInViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Member sign in";
}

<div class="auth">
    <aside class="auth-art">
        <a class="brand" asp-controller="Catalog" asp-action="Index">
            <span class="brand-mark" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#245a42" stroke-width="1.8"><path d="M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13C17 4 14 4.5 12 6zM12 6v13"/></svg></span>
            <span><span class="brand-name">JingYi</span><span class="brand-sub">PUBLIC LIBRARY</span></span>
        </a>
        <div class="art-copy">
            <p class="eyebrow">MEMBER ACCESS</p>
            <h2>Welcome back.<br />Sign in to your library.<br />Start reading today.</h2>
            <hr class="rule" />
            <p>Sign in to manage your loans, renew books and keep track of your reservations.</p>
        </div>
        <p class="art-foot">JINGYI PUBLIC LIBRARY / MEMBER ACCESS</p>
    </aside>

    <main class="auth-main">
        <p class="auth-tag"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> MEMBER SIGN IN</p>

        <section class="auth-card">
            <h1>Sign in to your account.</h1>
            <p class="lede">Enter your username and password to access your loans, reservations and library activity.</p>

            <form asp-controller="Account" asp-action="SignIn" method="post">
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="field">
                    <label asp-for="Username">Username</label>
                    <input asp-for="Username" placeholder="Enter your username" autocomplete="username" autofocus />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Password</label>
                    <div class="pw">
                        <input asp-for="Password" placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                @* placeholder until a reset-password page exists *@
                <a class="forgot" href="#">Forgot password?</a>

                <button type="submit" class="btn-primary">Sign in</button>
            </form>

            <p class="alt">Need an account? <a asp-action="SignUp">Join the library</a></p>
            <p class="alt"><a asp-controller="Catalog" asp-action="Index">← Browse books as a guest</a></p>
        </section>

        <p class="legal">Your library account is for personal use. Keep your password private.</p>
    </main>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }