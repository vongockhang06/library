@model library.ViewModels.Account.SignUpViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Join the library";
}

<div class="auth">
    <aside class="auth-art">
        <a class="brand" asp-controller="Catalog" asp-action="Index">
            <span class="brand-mark" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#245a42" stroke-width="1.8"><path d="M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13C17 4 14 4.5 12 6zM12 6v13" /></svg></span>
            <span><span class="brand-name">JingYi</span><span class="brand-sub">PUBLIC LIBRARY</span></span>
        </a>
        <div class="art-copy">
            <p class="eyebrow">PUBLIC MEMBERSHIP</p>
            <h2>Open a card.<br />Discover your library.<br />Start reading today.</h2>
            <hr class="rule" />
            <p>Create your JingYi member account to borrow books and keep your reading journey in one place.</p>
        </div>
        <p class="art-foot">JINGYI PUBLIC LIBRARY / PUBLIC MEMBERSHIP</p>
    </aside>

    <main class="auth-main">
        <p class="auth-tag"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg> PUBLIC MEMBERSHIP SIGNUP</p>

        <section class="auth-card">
            <h1>Create your account.</h1>
            <p class="lede">Sign up with your email address to get your JingYi Public Library membership.</p>

            <form asp-controller="Account" asp-action="SignUp" method="post">
                <div asp-validation-summary="ModelOnly" class="form-alert"></div>

                <div class="field">
                    <label asp-for="FullName">Full name <span class="hint">(up to 30 characters)</span></label>
                    <input asp-for="FullName" placeholder="Enter your full name" autocomplete="name" maxlength="30" autofocus />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Username">Username <span class="hint">(unique, up to 20 characters)</span></label>
                    <input asp-for="Username" placeholder="Choose a username" autocomplete="username" maxlength="20" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Email">Email <span class="hint">(up to 100 characters)</span></label>
                    <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" maxlength="100" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="PhoneNumber">Phone number</label>
                    <input asp-for="PhoneNumber" type="tel" inputmode="numeric" placeholder="Enter your 10-digit phone number" autocomplete="tel" maxlength="10" />
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Password</label>
                    <div class="pw">
                        <input asp-for="Password" placeholder="Create a password" autocomplete="new-password" />
                        <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="btn-primary">Create account</button>
            </form>

            <p class="alt">Already a member? <a asp-action="SignIn">Sign in</a></p>
        </section>

        <p class="legal">Your library account is for personal use. Keep your password private.</p>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}