@model library.ViewModels.GuestCatalogViewModel

@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Browse Books";
}

<!-- HEADER -->
<header class="site-header">
    <div class="header-inner">

        <a asp-controller="Guest"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">♧</div>

            <div class="brand-text">
                <span class="brand-name">JingYi</span>
                <span class="brand-subtitle">PUBLIC LIBRARY</span>
            </div>
        </a>

        <nav class="header-nav">
            <a asp-controller="Guest"
               asp-action="Index"
               class="nav-button active">
                Browse books
            </a>

            <a asp-controller="Account"
               asp-action="Login"
               class="nav-button">
                Member sign in
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="nav-button">
                Join the library
            </a>
        </nav>

    </div>
</header>


<!-- MAIN CONTENT -->
<main class="guest-container">

    <!-- INTRODUCTION -->
    <section class="intro-section">

        <div class="breadcrumb">
            GUEST / THE COLLECTION
        </div>

        <h1>Find your next good book.</h1>

        <p class="intro-description">
            Explore the shelves. Search by title, author or ISBN,
            then see what's available to borrow.
        </p>

    </section>


    <!-- SEARCH AND FILTER -->
    <section class="search-panel">

        <form asp-controller="Guest"
              asp-action="Index"
              method="get">

            <label class="search-label">
                Search the collection
            </label>

            <div class="search-row">

                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       placeholder="Search title, author or ISBN" />

                <button type="submit" class="search-button">
                    Search books →
                </button>

            </div>


            <div class="filter-row">

                <select name="category">
                    <option value="">All categories</option>

                    @foreach (var item in Model.Categories)
                    {
                        <option value="@item"
                                selected="@(Model.Category == item)">
                            @item
                        </option>
                    }
                </select>


                <select name="language">
                    <option value="">All languages</option>

                    @foreach (var item in Model.Languages)
                    {
                        <option value="@item"
                                selected="@(Model.Language == item)">
                            @item
                        </option>
                    }
                </select>


                <select name="availability">
                    <option value="">All availability</option>

                    <option value="Available"
                            selected="@(Model.Availability == "Available")">
                        Available
                    </option>

                    <option value="Unavailable"
                            selected="@(Model.Availability == "Unavailable")">
                        Unavailable
                    </option>
                </select>


                <select name="author">
                    <option value="">All authors</option>

                    @foreach (var item in Model.Authors)
                    {
                        <option value="@item"
                                selected="@(Model.Author == item)">
                            @item
                        </option>
                    }
                </select>

                <a asp-controller="Guest"
                   asp-action="Index"
                   class="clear-filter">
                    Clear filters
                </a>

            </div>

        </form>

    </section>


    <!-- COLLECTION HEADER -->
    <section class="collection-section">

        <div class="collection-header">

            <div>
                <h2>The collection</h2>

                <p class="collection-summary">
                    @Model.TotalTitles titles
                    · @Model.TotalCopies physical copies
                    · English edition 1
                </p>
            </div>

            <form asp-controller="Guest"
                  asp-action="Index"
                  method="get"
                  class="sort-form">

                <input type="hidden" name="searchTerm"
                       value="@Model.SearchTerm" />

                <input type="hidden" name="category"
                       value="@Model.Category" />

                <input type="hidden" name="language"
                       value="@Model.Language" />

                <input type="hidden" name="availability"
                       value="@Model.Availability" />

                <input type="hidden" name="author"
                       value="@Model.Author" />

                <label for="sortBy">Sort:</label>

                <select id="sortBy"
                        name="sortBy"
                        onchange="this.form.submit()">

                    <option value="BookId"
                            selected="@(Model.SortBy == "BookId")">
                        Book ID
                    </option>

                    <option value="Title"
                            selected="@(Model.SortBy == "Title")">
                        Title
                    </option>

                    <option value="Author"
                            selected="@(Model.SortBy == "Author")">
                        Author
                    </option>

                </select>

                <span>↓</span>
            </form>

        </div>


        <!-- BOOK GRID -->
        <div class="book-grid">

            @if (Model.Books.Any())
            {
                @foreach (var book in Model.Books)
                {
                    <article class="book-card">

                        <!-- BOOK COVER -->
                        <div class="book-cover"
                             style="background-color: @book.CoverColor">

                            <span class="cover-title">
                                @book.Title
                            </span>

                            <span class="cover-author">
                                @book.Author
                            </span>

                        </div>


                        <!-- BOOK INFORMATION -->
                        <div class="book-info">

                            <h3>@book.Title</h3>

                            <p class="book-author">
                                @book.Author
                            </p>

                            <p class="book-publisher">
                                @book.Publisher
                                · @book.Category
                            </p>

                            <p class="book-isbn">
                                ISBN @book.ISBN
                            </p>


                            @if (book.AvailableCopies > 0)
                            {
                                <span class="availability available">
                                    @book.AvailableCopies of @book.AvailableCopies available
                                </span>
                            }
                            else
                            {
                                <span class="availability unavailable">
                                    0 of 0 available
                                </span>
                            }


                            <a asp-controller="Guest"
                               asp-action="Details"
                               asp-route-id="@book.BookId"
                               class="view-book">
                                View book →
                            </a>

                        </div>

                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <h3>No books found</h3>
                    <p>Try changing your search or filters.</p>

                    <a asp-controller="Guest"
                       asp-action="Index">
                        Clear search
                    </a>
                </div>
            }

        </div>

    </section>


    <!-- BOTTOM BANNER -->
    <section class="join-banner">

        <div>
            <h2>A place on the shelf. A place for you.</h2>

            <p>
                Browse freely as a guest. Join or sign in to reserve
                titles and manage your reading.
            </p>
        </div>

        <a asp-controller="Account"
           asp-action="Register"
           class="join-button">
            Become a member →
        </a>

    </section>

</main>